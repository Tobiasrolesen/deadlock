  },
  "item": [
    {
      "name": "Search player by name",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", () => {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Correct player is returned\", () => {",
              "    pm.expect(pm.response.json().personaname).to.eql(\"Matelund\");",
              "});"
            ]
          }
        }
      ],
      "id": "4bb2b348-4110-46f0-aabd-6108ea233452",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/user/search/Matelund",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "user",
            "search",
            "Matelund"
          ]
        },
        "description": "Searches for a player by Steam profile name.\n\nExpected: **200** with `account_id`, `personaname` and `avatar`."
      },
      "response": [],
      "createdAt": "2026-11-23T11:19:16.000Z",
